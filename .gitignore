# Orbit files are large and re-fetchable; the scheduled job caches them instead.
orbits/

# Generated artifacts are never committed: ~18 MB a run becomes gigabytes of
# git history within a year. The scheduled job publishes the database as a
# release asset and the map straight to Pages. See update_sm_archive.yml.
catalog/
docs/index.html
exports/

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/
.coverage
htmlcov/
